APP_NAME=Laravel
CODING_AGENT_ENABLED=false
CODING_AGENT_OWNER_USER_ID=
CODING_AGENT_OWNER_EMAIL=
CODING_AGENT_REPOSITORIES='{}'
CODING_AGENT_MODELS='["agnes-3-0-flash:free","gpt-4o-mini:free","agnes-3-0-pro:free","llama-3.3-70b:free"]'
CODING_AGENT_DEFAULT_MODEL=agnes-3-0-flash:free
CODING_AGENT_GITHUB_TOKEN=
APP_ENV=local
APP_KEY=
# Local only. A production host must set APP_DEBUG=false and APP_ENV=production:
# with debug on, error pages render stack traces including environment values.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to secure when APP_ENV=production (config/session.php). Set false only
# for a plain-HTTP local host.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb - WebSocket server sendiri, memakai protokol Pusher.
# REVERB_HOST/PORT/SCHEME dipakai KLIEN (harus bisa dijangkau browser, lewat nginx).
# REVERB_SERVER_* dipakai SERVER saat mem-publish (daemon lokal, tanpa TLS).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=contoh.domain.tld
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Frontend menyambung ke Reverb memakai klien Pusher, jadi variabelnya tetap VITE_PUSHER_*.
VITE_PUSHER_APP_KEY="${REVERB_APP_KEY}"
VITE_PUSHER_HOST="${REVERB_HOST}"
VITE_PUSHER_PORT="${REVERB_PORT}"
VITE_PUSHER_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_TLDRAW_LICENSE_KEY=

# Sentry frontend error tracking
SENTRY_DSN=
VITE_SENTRY_DSN="${SENTRY_DSN}"
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ONERROR_SAMPLE_RATE=1

# Sentry backend error tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Production Database Sync (for db:sync-production command)
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_DATABASE=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=
